{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopepact.org/schemas/guard-policy-v1.schema.json",
  "title": "ScopePact Guard Policy v1",
  "description": "A bounded local capability policy for ScopePact Guard. The Guard additionally enforces UTF-8 byte limits, unique rule IDs, valid RFC 6901 pointers, and absolute-prefix semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policy_epoch",
    "principal",
    "agent",
    "valid_for_ms",
    "rules"
  ],
  "properties": {
    "policy_version": {
      "const": 1
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "principal": {
      "$ref": "#/$defs/name"
    },
    "agent": {
      "$ref": "#/$defs/name"
    },
    "valid_for_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2678400000
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/toolRule"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "literalResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "literal"
        },
        "value": {
          "$ref": "#/$defs/resource"
        }
      }
    },
    "argumentResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pointer", "prefix"],
      "properties": {
        "type": {
          "const": "argument"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "prefix": {
          "$ref": "#/$defs/resource"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prefix": {
                "pattern": "^/"
              }
            }
          },
          "then": {
            "properties": {
              "prefix": {
                "pattern": "/$"
              }
            }
          }
        }
      ]
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "amount_pointer",
        "payee_pointer",
        "max_spend_atomic",
        "allowed_payees"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[\\u0020-\\u007E]+$"
        },
        "amount_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "payee_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "max_spend_atomic": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_payees": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "toolRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "resource", "max_calls"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "tool": {
          "$ref": "#/$defs/name"
        },
        "resource": {
          "oneOf": [
            {
              "$ref": "#/$defs/literalResource"
            },
            {
              "$ref": "#/$defs/argumentResource"
            }
          ]
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "payment": {
          "$ref": "#/$defs/payment"
        }
      }
    }
  }
}
